RUN_CRONJOBS=1
JOB_BACKUP_ODOO_DB=odoo backup odoo-db $DB_ODOO_FILEFORMAT --dumptype $DB_ODOO_DUMPTYPE

# pgBackRest base backups. WAL is archived continuously by postgres itself
# (archive_command) in between, so these jobs only take the base states.
#
# Three of them because the types differ in what they cost and what they buy:
#
#   full  a complete copy. Weekly, on the quietest day.
#   diff  everything changed since the last full. Daily.
#   incr  everything since the last backup of any type. Optional, intra-day.
#
# All three no-op quietly unless RUN_PGBACKREST=1 - they run on every project,
# and a project without pgbackrest must not log a cron error every night.
#
# Retention is NOT a separate job on purpose: pgbackrest expires as the last
# step of every backup. A cleanup that has to be scheduled separately is a
# cleanup that eventually is not (see JOB_DADDY_CLEANUP below, which has no
# CRONJOB_ counterpart and therefore never runs).
# Kennzahlen zur Sicherung fuer die Ueberwachung. Alle fuenf Minuten, weil
# der Wert nicht die Sicherung selbst ist, sondern die Antwort auf "wann war
# die letzte" -- die aendert sich hoechstens einmal am Tag. Haeufiger als
# noetig ist er trotzdem: faellt der Schreiber aus, soll das schnell
# auffallen (zodoo_backup_metrics_written_timestamp_seconds altert dann).
#
# Laeuft auf jedem Projekt und steigt ohne pgbackrest/dashboard still aus.
JOB_BACKUP_METRICS=odoo backup-metrics
CRONJOB_BACKUP_METRICS=*/5 * * * * $JOB_BACKUP_METRICS
JOB_PGBACKREST_FULL=odoo pgbackrest backup --type full
CRONJOB_PGBACKREST_FULL=$PGBR_FULL_CRON $JOB_PGBACKREST_FULL
JOB_PGBACKREST_DIFF=odoo pgbackrest backup --type diff
CRONJOB_PGBACKREST_DIFF=$PGBR_DIFF_CRON $JOB_PGBACKREST_DIFF
JOB_PGBACKREST_INCR=odoo pgbackrest backup --type incr
CRONJOB_PGBACKREST_INCR=$PGBR_INCR_CRON $JOB_PGBACKREST_INCR

# Stuendlich den ganzen Weg pruefen: ein WAL-Segment weiterschalten und
# nachsehen, ob es im Repository ankommt. Das ist die einzige Pruefung, die
# die Instanz SELBST ueber ihre Sicherung anstellen kann - alles andere sieht
# man erst auf dem Backup-Server, und dort faellt ein stehengebliebener
# Archivierer erst nach Stunden auf. --record legt das Ergebnis ab, damit
# `odoo backup-metrics` eine Kennzahl daraus machen kann.
JOB_PGBACKREST_CHECK=odoo pgbackrest check --record
CRONJOB_PGBACKREST_CHECK=17 * * * * $JOB_PGBACKREST_CHECK

# Taegliches verschluesseltes Offsite-Backup (restic). No-op solange
# RUN_OFFSITE=0 - der Befehl steigt dann still aus, damit Projekte ohne
# Offsite-Ziel nicht jede Nacht einen Cron-Fehler melden. Laeuft nach dem
# pgBackRest-Basisbackup, damit der frische Stand mitgeht.
# Die vom Backup-Server vorgegebene Aufbewahrung holen. Die Instanz FUEHRT sie
# aus (nur sie kann backup.info entschluesseln), BESTIMMEN soll sie der Server.
#
# Was dieser Job NICHT tut: wirksam machen. Der geholte Wert landet in den
# Einstellungen und wird beim naechsten `odoo reload` in die pgbackrest.conf
# gerendert - `odoo reload` aus einem Container heraus bricht seit 11.0.1
# absichtlich ab (falsche Bind-Mount-Pfade), also kann dieser Job das nicht
# selbst erledigen. Bis dahin gilt der alte Wert, und die LUECKE deckt die
# Ueberwachung auf dem Backup-Server ab (backup.retention.tooshort).
JOB_PGBACKREST_POLICY=odoo pgbackrest policy
CRONJOB_PGBACKREST_POLICY=$PGBR_POLICY_CRON $JOB_PGBACKREST_POLICY

JOB_OFFSITE_BACKUP=odoo offsite backup
CRONJOB_OFFSITE_BACKUP=$OFFSITE_BACKUP_CRON $JOB_OFFSITE_BACKUP

# WAL-Segmente hochschieben, minuetlich (siehe OFFSITE_WAL_CRON). Ohne
# write-only Datenbankziel ein stiller Nichtstuer, mit einem verkleinert es das
# Verlustfenster von einer Nacht auf eine Minute. Laeuft nie doppelt: ein
# belegtes Lock ist ein ruhiger Erfolg, kein Fehler - sonst gaebe es waehrend
# eines langen Basisbackup-Uploads jede Minute eine Fehlermeldung.
JOB_OFFSITE_WAL=odoo offsite wal
CRONJOB_OFFSITE_WAL=$OFFSITE_WAL_CRON $JOB_OFFSITE_WAL

JOB_DADDY_CLEANUP=odoo daddy-cleanup /host/dumps/$DB_ODOO_SEARCHFORMAT --dont-touch 1
JOB_KEEP_LAST_FILE_OF_DAY=odoo keep-latest-file-of-day /host/dumps/$DB_ODOO_SEARCHFORMAT --doNt-touch 1
JOB_VACUUM=odoo psql --sql "vacuum full"

JOB_CLEAN_LONG_RUNNING_QUERIES=postgres.py exec $DBNAME $DB_HOST $DB_PORT $DB_USER $DB_PWD "SELECT pid, now() - pg_stat_activity.query_start AS duration, query, state INTO temp_pids FROM pg_stat_activity WHERE (now() - pg_stat_activity.query_start) > interval '120 minutes';select * from temp_pids; select pg_cancel_backend(pid) from temp_pids;"\;
JOB_KILL_DB_LOCKS=postgres.py exec $DBNAME $DB_HOST $DB_PORT $DB_USER $DB_PWD "select * into temporary table locks from lock_monitor where blocked_query not ilike 'ir_cron' and extract(epoch from waiting_duration) > 20; select * from locks; select pg_terminate_backend(blocked_pid) from locks; select * from locks;"\;

#CRONJOB_TEST=* * * * * * odoo backup odoo-db /tmp/1...........
#CRONJOB_TEST1=* * * * * * echo test cronjobi1

CRONJOB_BACKUP_FILES=0 0 * * * odoo backup files /host/dumps/${DBNAME}.files; ls -lhtra /host/dumps



# Fehlende Anhaenge aus dem gemeinsamen Pool zurueckholen (nur bei
# ODOO_FILES_COMMON=1, sonst steigt der Befehl still aus).
#
# Warum das HIER laeuft und nicht einmal pro Host: heilen ist
# datenbankgetrieben, es liest ir_attachment.store_fname. Auf Maschinen, wo
# jede Instanz ihren eigenen postgres-Container hat, erreicht nur die Instanz
# selbst ihre Datenbank - ein zentraler Job kann die DB einer fremden Instanz
# gar nicht befragen.
#
# --no-dedup: umgekehrt gehoert das Deduplizieren dem Filestore-Root und
# laeuft einmal pro Host (`odoo filestore install-cron`). Wuerde jede Instanz
# auch deduplizieren, tasteten sich zwanzig Instanzen jede Nacht gegenseitig
# den Filestore ab.
#
# --wait: alle Instanzen eines Hosts teilen ein Lock. Ohne Warten wuerde beim
# gleichzeitigen Start genau eine heilen und der Rest still aussteigen.
#
# Wochentlich, nicht taeglich: seit die Instanzen ueber Hardlinks statt
# Symlinks teilen, kann neuer Schaden strukturell nicht mehr entstehen - das
# ist ein Netz fuer Altbestand, kein Reparaturdienst. Nach einem Restore
# heilt ausserdem schon das CI-System.
#
# Rein additiv: es entstehen nur fehlende Hardlinks. Eine Instanz ist damit
# nie, auch nicht kurz, ohne Filestore, und es braucht keinen Neustart.
FILESTORE_HEAL_CRON=40 2 * * 0
JOB_FILESTORE_HEAL=odoo filestore sync --no-dedup --wait
CRONJOB_FILESTORE_HEAL=$FILESTORE_HEAL_CRON $JOB_FILESTORE_HEAL

JOB_RESTART_UNHEALTHY_CONTAINERS=/bin/bash restart_unhealthy_containers.sh
CRONJOB_RESTART_UNHEALTHY_CONTAINERS=* * * * * $JOB_RESTART_UNHEALTHY_CONTAINERS
