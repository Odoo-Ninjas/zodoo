upstream {{ item.upstream_name }} {
    server {{ item.upstream_server }}:{{ item.upstream_port }};
}

{% if item.before_server_conf is defined and item.before_server_conf %}
{{ item.before_server_conf }}
{% else %}
# BEFORE_SERVER_CONF
{% endif %}


server {
        server_name  {{ item.server_name }};
        keepalive_timeout 60;

        proxy_buffers 16 1024k;
        proxy_buffer_size 256k;

{% if item.client_max_body_size is defined and item.client_max_body_size %}
        # 0 = no limit. Needed for uploads that are streamed rather than
        # measured beforehand - a filestore bundle has no size known in advance.
        client_max_body_size {{ item.client_max_body_size }};
{% else %}
        client_max_body_size 1024M;
{% endif %}
{% if item.proxy_request_buffering is defined and item.proxy_request_buffering == False %}
        # Hand the body upstream as it arrives instead of spooling the whole
        # request to disk first. For multi-gigabyte uploads the default would
        # mean writing everything twice and delaying the backend until the last
        # byte has landed on the proxy.
        proxy_request_buffering off;
{% endif %}

{% include "_ip_allowlist.inc" %}
        # BASIC_AUTH

        more_clear_headers Server X-Powered-By;

{% if item.locations is defined and item.locations %}
        {{ item.locations }}
{% else %}
        # LOCATIONS
{% endif %}
        location /nginx-status {
            # Turn on stats
            stub_status on;
            access_log   off;
        }


        location / {
                add_header X-XSS-Protection "1; mode=block";
                # SWM pentest result:
                #add_header "content_security_policy" "default-src 'self'; script-src 'self'";
                # chrome has errors with headers:
                add_header Content-Security-Policy "upgrade-insecure-requests" always;
                add_header "Strict-Transport-Security" "max-age=63072000; includeSubDomains; preload";
                
                # ADDITIONAL_HEADERS_ANSIBLE
{% if ((item.ssl_key_is_on_destination is defined and item.ssl_key_is_on_destination) or (item.ssl_server_cert is defined and item.ssl_server_cert)) and item.headers is defined and item.headers %}
# BEGIN Additional Headers by Ansible for {{ item.server_name }}
{{ item.headers }}
# END Additional Headers by Ansible for {{ item.server_name }}
{% endif %}

                set $var_{{ item.upstream_name }} {{ item.upstream_name }};
{% if item.upstream_scheme is defined and item.upstream_scheme == 'https' %}
                # The backend speaks TLS itself. Certificate verification stays
                # off (nginx's default for proxy_pass): these are our own
                # machines on a private network, reached by address, and their
                # certificates are issued by our own CA - so there is no name to
                # verify against and nothing a public trust store could say.
                proxy_pass https://$var_{{ item.upstream_name }};
{% else %}
                proxy_pass http://$var_{{ item.upstream_name }};
{% endif %}

                # enable websockets
                proxy_http_version      1.1;
                proxy_redirect          off;
                proxy_set_header        Upgrade $http_upgrade;
                proxy_set_header        Connection "upgrade";

                proxy_next_upstream     error timeout invalid_header http_500 http_502 http_503 http_504;
                proxy_set_header        Host $http_host;


                # not sure if next setting requierd or not; was found on a production system
                #proxy_set_header Host $http_host;

                proxy_set_header X-Forwarded-Host $host;
                proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
                proxy_set_header X-Forwarded-Proto $scheme;
                proxy_set_header X-Real-IP $remote_addr;

                proxy_connect_timeout   {{ item.timeout }};
                proxy_send_timeout      {{ item.timeout }};
                proxy_read_timeout      {{ item.timeout }};
        }

        location /.well-known/accme-challenge/ {
            root /var/www/certbot;
        }

        # SSL_CERTIFICATE_ANSIBLE
{% if (item.ssl_key_is_on_destination is defined and item.ssl_key_is_on_destination) or (item.ssl_server_cert is defined and item.ssl_server_cert) %}
# BEGIN SSL Parameters by Ansible for {{ item.server_name }}
# SSL parameters
listen 443 ssl;
ssl_certificate /etc/ssl/custom_ssl/{{ item.certificate_name }}/server.crt;
ssl_certificate_key /etc/ssl/custom_ssl/{{ item.certificate_name }}/server.key;
ssl_session_timeout 30m;
ssl_protocols TLSv1 TLSv1.1 TLSv1.2;
ssl_ciphers 'ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-AES256-GCM-SHA384:DHE-RSA-AES128-GCM-SHA256:DHE-DSS-AES128-GCM-SHA256:kEDH+AESGCM:ECDHE-RSA-AES128-SHA256:ECDHE-ECDSA-AES128-SHA256:ECDHE-RSA-AES128-SHA:ECDHE-ECDSA-AES128-SHA:ECDHE-RSA-AES256-SHA384:ECDHE-ECDSA-AES256-SHA384:ECDHE-RSA-AES256-SHA:ECDHE-ECDSA-AES256-SHA:DHE-RSA-AES128-SHA256:DHE-RSA-AES128-SHA:DHE-DSS-AES128-SHA256:DHE-RSA-AES256-SHA256:DHE-DSS-AES256-SHA:DHE-RSA-AES256-SHA:AES128-GCM-SHA256:AES256-GCM-SHA384:AES128-SHA256:AES256-SHA256:AES128-SHA:AES256-SHA:AES:CAMELLIA:DES-CBC3-SHA:!aNULL:!eNULL:!EXPORT:!DES:!RC4:!MD5:!PSK:!aECDH:!EDH-DSS-DES-CBC3-SHA:!EDH-RSA-DES-CBC3-SHA:!KRB5-DES-CBC3-SHA';
ssl_prefer_server_ciphers on;
# END SSL Parameters by Ansible for {{ item.server_name }}
{% endif %}
}