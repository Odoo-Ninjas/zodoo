# MARKER COMMON.DOCKER BEGIN

# install zodoo
RUN #___SNIPPET_APT_INSTALL___ \
build-essential python3-dev
RUN python3 -mpip install $(cat /etc/pip_options) pipx --upgrade
USER root

#___SNIPPET_ZODOO___

# When ZODOO_EMBED=1 (bakery/k8s self-contained images), the project layer
# copies the zodoo source into the image. In standard mode this marker is
# replaced with an empty string by the composer and the source is supplied
# via the docker-compose bind-mount instead.
#___SNIPPET_ZODOO_EMBED_SOURCE___

USER root
RUN echo 'export PATH=$PATH:/usr/local/bin/pipxbin' >> /root/.bashrc


# pudb config
RUN mkdir /home/odoo/.config/pudb -p
COPY pudb.cfg /home/odoo/.config/pudb
RUN chown odoo:odoo /home/odoo/.config -R

RUN touch /helpme

ENV ODOO_USER=odoo
ENV ODOO_DATA_DIR=/opt/files
ENV ODOO_HOME=/opt/odoo
ENV ODOO_CONFIG_TEMPLATE_DIR=/etc/odoo/config.template
ENV ODOO_CONFIG_DIR=/etc/odoo/config
ENV ODOO_SUDO_CMD=1
ENV OUT_DIR=/opt/out_dir
ENV RUN_DIR=/opt/run
ENV INTERCOM_DIR=/intercom
ENV CUSTOMS_DIR=/opt/src
ENV ODOOLIB=/odoolib
ENV PYTHONPATH=/odoolib:/opt/tools
ENV LANG=en_US.UTF-8
ENV LANGUAGE=en_US:en
ENV LC_ALL=en_US.UTF-8
ENV PYTHONBREAKPOINT=0
ENV ODOO_SERVER_TOOLS_MODULES=/opt/odoo_server_tools
ENV ODOO_FRAMEWORK_KEEP_SQL_CONNECTION=1
ENV PATH=/odoolib:/opt/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ENV DOCKER_HOST_RUN_DIR=/opt/run

# Forward zodoo settings through `sudo -u odoo` (see odoo/bin/tools.py).
# Default sudoers policy is `env_reset`, which drops everything not in
# `env_keep` — even with `-E`. Without this whitelist, settings defined
# in a Kubernetes Pod env (or via `docker run -e ...`) reach root inside
# the container but never the `odoo` user that actually runs Odoo.
# Names mirror the keys present across all images/*/default.settings.
RUN { \
      echo 'Defaults env_keep += "ODOO_* RUN_* DB_* LIMIT_MEMORY_*"'; \
      echo 'Defaults env_keep += "JOB_* CRONJOB_* BROWSER_* VSCODE_* PROXY_*"'; \
      echo 'Defaults env_keep += "POSTGRES_* TEST_MAIL_* INTERNAL_ODOO_* ROUNDCUBE_*"'; \
      echo 'Defaults env_keep += "QUEUEJOBS_* ZODOO_* CONSOLE_PASSWORD CUPS_PORT"'; \
      echo 'Defaults env_keep += "DEFAULT_DEV_PASSWORD FASTIFY_DEBUG LOGS_PASSWORD"'; \
      echo 'Defaults env_keep += "MAIL_AUTOLOGIN NAMED_ODOO_POSTGRES_VOLUME"'; \
      echo 'Defaults env_keep += "SHA_IN_DOCKER SRC_EXTRA CHANGE_POSTGRES_OWNER_TO_ODOO"'; \
      echo 'Defaults env_keep += "DBNAME PROJECT_NAME CUSTOMS_DIR DOCKER_HOST_RUN_DIR"'; \
    } > /etc/sudoers.d/zodoo-env-passthrough && \
    chmod 440 /etc/sudoers.d/zodoo-env-passthrough && \
    visudo -cf /etc/sudoers.d/zodoo-env-passthrough

ADD bin/ /odoolib/
ENV ODOO_CONFIG_DIR=${ODOO_CONFIG_DIR}
ADD config/${ODOO_VERSION}/config ${ODOO_CONFIG_DIR}.template

CMD ["sh", "-c", "$ZODOO_PYTHON /odoolib/supervisor.py"]
ENTRYPOINT ["/odoolib/entrypoint.sh"]

ADD static /var/www/html


RUN #___SNIPPET_APT_INSTALL___ \
zstd

ENV ZSTDOPTIONS="-10 -T4"

WORKDIR /opt/src


# ============================================================
# CLEANUP — single consolidated RUN, executed BEFORE the venv
# tar so that /opt/venv.tar.zst doesn't carry __pycache__,
# static archives, and other build leftovers from the pip
# installs. Combines the old SNIPPET_CLEANUP body with the
# inline cleanups that used to follow it. After this step no
# apt operations are possible — /var/lib/dpkg is removed.
# ============================================================
RUN apt-get purge -y \
        imagemagick-dev libmagickcore-dev libmagickwand-dev \
        perl perl-base \
        libgl1-mesa-dri libcodec2-1.0 ffmpeg libavcodec58 \
        librsvg2-2 libgtk-3-0 libasan* libtsan* \
        build-essential gcc g++ libpq-dev || true && \
    apt-get autoremove -y || true && \
    apt-get clean -y || true && \
    find /usr -name '*.a' -delete && \
    find / -type d -name __pycache__ -exec rm -Rf {} + 2> /dev/null || true && \
    find /usr/lib/locale -mindepth 1 -maxdepth 1 -type d \
        ! -name '*en_US*' -exec rm -rf {} + || true && \
    rm -Rf \
        /usr/lib/*/ImageMagick*/modules-*/*/*.la \
        /usr/lib/*/ImageMagick*/modules-*/*/*.a \
        /opt/python \
        /usr/local/lib/python*/test \
        /usr/lib/jvm \
        /usr/local/bin/wkhtmltoimage \
        /usr/local/lib/python*/config-* \
        /usr/lib/aarch64-linux-gnu/libLLVM* \
        /usr/lib/aarch64-linux-gnu/libasan.so* \
        /usr/lib/aarch64-linux-gnu/libtsan.so* \
        /usr/lib/aarch64-linux-gnu/liblsan.so* \
        /usr/lib/aarch64-linux-gnu/libubsan.so* \
        /usr/lib/aarch64-linux-gnu/libhwasan.so* \
        /usr/lib/aarch64*/perl \
        /usr/bin/aarch64*dump \
        /usr/bin/aarch64-linux-gnu-ld* \
        /usr/bin/aarch64-linux-gnu-as \
        /usr/bin/aarch64-linux-gnu-ar \
        /usr/bin/aarch64-linux-gnu-ranlib \
        /usr/bin/aarch64-linux-gnu-dwp \
        /usr/bin/aarch64-linux-gnu-c++filt \
        /usr/bin/aarch64-linux-gnu-nm \
        /usr/bin/aarch64-linux-gnu-size \
        /usr/bin/aarch64-linux-gnu-cpp* \
        /usr/bin/aarch64-linux-gnu-gprof \
        /usr/bin/cmake /usr/bin/cpack /usr/bin/ctest \
        /usr/bin/meson /usr/bin/ninja \
        /usr/lib/python3 \
        /usr/lib/postgresql \
        /etc/ssh \
        /tmp/* /var/tmp/* /var/log/* \
        /usr/share/doc /usr/share/man /usr/share/icons /usr/share/vim \
        /usr/share/perl /usr/share/poppler \
        /usr/share/cmake-3.22 /usr/share/cmake \
        /usr/share/emacs /usr/share/emacsen-common \
        /usr/share/java /usr/share/X11 \
        /usr/share/python-wheels /usr/share/iso-codes /usr/share/javascript \
        /usr/share/i18n \
        /usr/lib/gcc /var/cache /usr/lib/git-core \
        /var/lib/dpkg /var/lib/apt/lists/* /usr/include && \
    rm -f /usr/bin/aarch64-linux-gnu-lto-dump-11


# Tar venv + zodoo_pipx — now without __pycache__/.a leftovers
RUN cd /opt && \
    #___SNIPPET_TAR___
    venv zodoo_pipx | zstd $ZSTDOPTIONS > venv.tar.zst && rm -Rf venv zodoo_pipx '


# Tar /usr/share
RUN cd /usr && \
    #___SNIPPET_TAR___
    share | zstd $ZSTDOPTIONS > share.tar.zst && rm -Rf share && cd - '

# --- Flatten all layers to remove dead bytes from cleanup ---
FROM scratch AS final
COPY --from=2 / /

ENV DEBIAN_FRONTEND=noninteractive
ENV PIP_NO_CACHE_DIR=no
ENV LANG=en_US.UTF-8
ENV LANGUAGE=en_US:en
ENV LC_ALL=en_US.UTF-8
ENV PYTHONBREAKPOINT=0
ENV VIRTUAL_ENV=/opt/venv/env
ENV ZODOO_SRC=/opt/zodoo
ENV ZODOO_PIPX_HOME=/opt/zodoo_pipx
ENV ZODOO_ENV_DIR=/opt/zodoo_pipx/venvs/zodoo
ENV ZODOO_PYTHON=$ZODOO_ENV_DIR/bin/python3
ENV ODOO_USER=odoo
ENV ODOO_DATA_DIR=/opt/files
ENV ODOO_HOME=/opt/odoo
ENV ODOO_CONFIG_TEMPLATE_DIR=/etc/odoo/config.template
ENV ODOO_CONFIG_DIR=/etc/odoo/config
ENV ODOO_SUDO_CMD=1
ENV OUT_DIR=/opt/out_dir
ENV RUN_DIR=/opt/run
ENV INTERCOM_DIR=/intercom
ENV CUSTOMS_DIR=/opt/src
ENV ODOOLIB=/odoolib
ENV PYTHONPATH=/odoolib:/opt/tools
ENV ODOO_SERVER_TOOLS_MODULES=/opt/odoo_server_tools
ENV ODOO_FRAMEWORK_KEEP_SQL_CONNECTION=1
ENV PATH=/odoolib:/opt/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ENV DOCKER_HOST_RUN_DIR=/opt/run
ENV ZSTDOPTIONS="-10 -T4"

WORKDIR /opt/src
CMD ["sh", "-c", "$ZODOO_PYTHON /odoolib/supervisor.py"]
ENTRYPOINT ["/odoolib/entrypoint.sh"]

# MARKER COMMON.DOCKER END
