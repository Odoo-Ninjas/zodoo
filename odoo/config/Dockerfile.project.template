# Template for the project-layer Odoo image. Composer renders this on top
# of a pre-built base image (`odoo_base_<v>_<hash>_<arch>`). Only project-
# specific extras are installed here; the heavy Python+framework+deb work
# is already in the base.
#
# Layer ordering rule: STATIC layers (no volatile-ARG dependency) come
# first via the inserted common-docker block (zodoo CLI install, pudb
# config, env vars, sudoers — all static), THEN the project-delta block
# (volatile ARGs + apt/pip install of project_requirements.txt /
# project_deb_requirements.txt), and FINALLY the common-docker cleanup
# + tar + FROM-scratch flatten. Adding a new project pip dep therefore
# only invalidates the small delta block + the (already volatile)
# cleanup/tar steps, not the ~25 static layers above.

ARG BASE_TAG
ARG TARGETARCH
ARG ODOO_VERSION
ARG ODOO_PYTHON_VERSION

FROM ${BASE_TAG} AS project
ARG TARGETARCH
ARG ODOO_VERSION
ARG ODOO_PYTHON_VERSION

ENV PIP_NO_CACHE_DIR=no
ENV LANG=C.UTF-8

WORKDIR /opt/odoo

# Composer replaces this marker with the contents of
# odoo/config/common.docker, after having injected the project-delta
# block into the common-docker's own `MARKER PROJECT_DELTA_INSERT`
# placeholder (= cleanup-aware position: between the static zodoo CLI
# install and the destructive cleanup).
# MARKER COMMON_STATIC
