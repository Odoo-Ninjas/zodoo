RUN_POSTGRES=1
RUN_POSTGRES_IN_BTRFS=0
DB_HOST=postgres
DB_PORT=5432
DB_USER=odoo
DB_PWD=odoo
DB_MAXCONN=5000
POSTGRES_SHM_SIZE=1gb
POSTGRES_CONFIG=shared_preload_libraries='pg_stat_statements,auto_explain';
#POSTGRES_CONFIG_LOGGING_DEMO=logging_collector=on;log_directory=/logs;log_filename=postgresql.log;log_statement=all
POSTGRES_VERSION=17

NAMED_ODOO_POSTGRES_VOLUME=
