# these settings are applied
# you can provide a custom project based configuration
# in
# ~/.odoo/postgres.conf
# ~/.odoo/postgres.<project>.conf

# max_connections is computed dynamically in postgres/__after_settings.py
# from ODOO_WORKERS_WEB + ODOO_MAX_CRON_THREADS + queuejob_workers * 1.2 + 10.
# Override by setting max_connections= in POSTGRES_CONFIG.
track_activity_query_size=16384
wal_compression=on
effective_cache_size=4GB
maintenance_work_mem=512MB
work_mem=64MB
shared_buffers=4000MB
track_activity_query_size=16384;
#logging_collector=on
#log_directory=/logs
#log_filename=postgresql.log
#log_statement=all
shared_preload_libraries='pg_stat_statements,auto_explain'

# observability — measure which queries are slow and where I/O time goes
track_io_timing=on
log_min_duration_statement=1000

# autovacuum — keep up with write-heavy Odoo workloads (hr_attendance,
# mail_message, queue_job tend to bloat fast)
autovacuum_max_workers=6
autovacuum_vacuum_cost_limit=2000

# Odoo queries are I/O-bound and cheap to plan; JIT compilation usually
# costs more than it saves.  Disable globally — re-enable per session
# with SET jit=on if a specific report benefits.
jit=off
