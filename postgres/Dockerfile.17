FROM postgres:17-bookworm

# The pgBackRest version, pinned. Not cosmetic: pgbackrest requires the SAME
# version on every host that talks to a repository - client and repo server
# alike. On a mismatch WAL archiving and backups stop with
#
#   [ProtocolError] expected value '2.x' for greeting key 'version' but got '2.y'
#
# Unpinned, two images built a few weeks apart already differ, and the failure
# only shows up against the backup server. The pin is a "-*" suffix because
# the pgdg package revision is distribution-specific (2.59.1-1.pgdg24.04+1 vs
# 2.59.1-1.pgdg12+1) while the upstream version is what has to match.
#
# Empty means unpinned, which is what a project without pgBackRest gets.
ARG PGBR_VERSION=
CMD ["postgres"]

#___SNIPPET_APT_PROXY___

COPY config* /
COPY run.sh /run.sh
COPY init/* /docker-entrypoint-initdb.d/
RUN chown -R postgres:postgres /docker-entrypoint-initdb.d && \
    chmod a+x /docker-entrypoint-initdb.d/*.sh /run.sh

# Install + Cleanup in einem Layer um dead layers zu vermeiden
RUN #___SNIPPET_APT_INSTALL___ \
    postgresql-server-dev-17 python-dev build-essential git python3-pip procps sockstat && \
    #___SNIPPET_APT_INSTALL___ \
    postgresql-17-postgis-3 postgresql-17-pgvector "pgbackrest${PGBR_VERSION:+=${PGBR_VERSION}-*}" ncdu python3 && \
    apt-get purge -y git git-core gnupg gnupg2 binutils && \
    (apt-get purge -y libgdal* libarmadillo* libogdi* libasan* libtsan* libubsan* || true) && \
    apt-get purge -y build-essential gcc g++ libpq-dev postgresql-server-dev-17 python-dev && \
    apt-get autoremove -y && \
    apt-get clean -y && \
    find /usr -name '*.a' -delete && \
    find / -type d -name __pycache__ -exec rm -rf {} + 2>/dev/null; \
    rm -rf \
      /usr/share/perl \
      /usr/share/doc \
      /usr/share/man \
      /usr/share/icons \
      /usr/share/vim \
      /usr/share/poppler \
      /usr/lib/gcc \
      /usr/lib/llvm-* \
      /usr/lib/aarch*/perl \
      /usr/lib/python2.7 \
      /usr/lib/dpkg \
      /usr/lib/bfd-plugins \
      /usr/lib/git-core \
      /usr/include \
      /var/lib/apt/lists/* \
      /var/cache \
      /var/log/* \
      /tmp/* \
      /var/tmp/* \
      /etc/ssh

# Nachweis, dass pgbackrest den Aufraeumblock ueberlebt hat.
#
# Warum das noetig ist: der Installations- und Aufraeumblock oben endet mit
# `find ... 2>/dev/null;` - einem SEMIKOLON. Der Rueckgabewert des ganzen RUN
# ist damit der des abschliessenden `rm -rf`, und der gelingt praktisch immer.
# Scheitert weiter oben etwas - etwa `apt-get install pgbackrest=<version>-*`,
# weil der Debian-Spiegel genau diese Version nicht mehr fuehrt, oder weil ein
# `purge` sie mitreisst - dann BAUT DAS ABBILD TROTZDEM DURCH, nur ohne
# pgbackrest.
#
# Sichtbar wird das erst im Betrieb, und zwar weit weg von der Ursache: das
# archive_command stirbt mit `pgbackrest: command not found` (exit 127), und
# was man sieht, ist "WAL segment was not archived before the timeout". Wer
# darauf den Timeout hochsetzt, behandelt das Symptom.
#
# Am 04.09.2026 hat genau das die pgBackRest-e2e-Tests gekippt (auf main und
# auf einem Zweig, im selben Commit mal rot mal gruen) - und vorher eine echte
# Instanz getroffen, deren Archivierung nach dem Bauen nie lief.
RUN command -v pgbackrest && pgbackrest version
