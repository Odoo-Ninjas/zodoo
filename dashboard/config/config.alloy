// Grafana Alloy (Promtail's successor) — unified collector for the dashboard.
//   1. ships every container's stdout/stderr to Loki  -> "errors last 24h", log stats
//   2. tails the proxy's JSON access log, extracts request metrics for Prometheus
//      and forwards the structured lines to Loki -> per-route response time, slowest routes

logging {
  level  = "warn"
  format = "logfmt"
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}

/////////////////////////////////////////////////////////////////////////////
// 1) Container logs -> Loki
//
// discovery.docker sieht JEDEN Container der Maschine, nicht nur die des
// eigenen Projekts. Bis September 2026 hat deshalb jede Instanz die Logs
// aller anderen mitgeschrieben: auf cicd-3dm lasen sechs alloy dieselben
// 123 Container und legten sie in sechs Lokis ab -- zusammen rund 9 GB im
// Wesentlichen derselben Zeilen. Und wer an ein Grafana einer Instanz kam
// (/logs2), las damit die Logs aller Projekte der Maschine mit.
//
// Deshalb die keep-Regel unten: behalten wird, was zum eigenen
// Compose-Projekt gehoert. Den Namen setzt zodoo beim Erzeugen der
// Compose-Datei als DASHBOARD_LOGS_PROJECT_REGEX an diesen Dienst
// (dashboard/__after_compose.py).
//
// Das coalesce ist kein Schmuck: diese Datei liegt im gemeinsamen
// images-Verzeichnis und ist nach einem `git pull` sofort aktiv, die
// Compose-Datei einer Instanz entsteht aber erst beim naechsten `odoo
// reload`. In der Luecke dazwischen gibt es die Variable noch nicht -- ein
// leerer Regex wuerde auf "nur Container ohne Projekt-Label" hinauslaufen,
// und die Logs waeren still weg. Ohne Variable bleibt es deshalb beim
// alten Verhalten.
//
// Alle Container der Maschine will man trotzdem manchmal sehen (etwa auf
// einer Maschine, auf der auch Nicht-zodoo-Container laufen): dafuer gibt
// es DASHBOARD_LOGS_ALL_CONTAINERS=1.
/////////////////////////////////////////////////////////////////////////////
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    regex         = coalesce(sys.env("DASHBOARD_LOGS_PROJECT_REGEX"), ".*")
    action        = "keep"
  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/?(.*)"
    target_label  = "container"
  }
  rule {
    source_labels = ["__meta_docker_container_log_stream"]
    target_label  = "stream"
  }
}

loki.source.docker "containers" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.relabel.containers.output
  labels        = { job = "docker" }
  forward_to    = [loki.write.default.receiver]
}

/////////////////////////////////////////////////////////////////////////////
// 2) nginx JSON access log -> request metrics (Prometheus) + structured Loki
/////////////////////////////////////////////////////////////////////////////
local.file_match "nginx" {
  path_targets = [{
    __path__ = "/var/log/nginx/access.json",
    job      = "nginx",
  }]
}

// The proxy already writes one JSON object per line, so no processing is
// needed: ship the raw lines under the single stream label job="nginx".
// The dashboard parses status / request_time / uri at query time with
// `| json`, which keeps response-time percentile queries to a single series.
loki.source.file "nginx" {
  targets    = local.file_match.nginx.targets
  forward_to = [loki.write.default.receiver]
}
