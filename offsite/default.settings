RUN_OFFSITE=0
# Encrypted offsite backup with restic.
#
# restic encrypts and deduplicates on THIS machine, before anything leaves the
# network. The storage side only ever sees ciphertext and can neither read the
# data nor change it unnoticed.
#
# The normal case is our own backup server (restic-backup): rest-server runs
# there with --append-only, and every instance has its own area. This machine
# may write there but may NOT delete anything - so a compromised Odoo machine
# cannot destroy the backups. Retention therefore runs server-side (see
# OFFSITE_KEEP_*).
#
# An area is not wired up by hand but requested with
#   odoo offsite register
# That files a request for a customer area; an admin approves it on the backup
# server, after which the same command collects credentials and the server
# certificate and writes them into the settings.
#
# Repository address. Three forms:
#   rest:https://10.222.0.106:8000/<area>/                       our backup server (normal case)
#   sftp:u123456@u123456.your-storagebox.de:23/zodoo/<project>   Storage Box
#   /path/on/a/mounted/disk
# Empty means offsite backup is not configured; `odoo offsite backup` then
# aborts with an explanation instead of quietly doing nothing.
OFFSITE_REPO=
# Access to the area on the backup server (rest: targets only). It governs WHO
# may write - not who can read. Reading is governed by the passphrase.
# Set by `odoo offsite register`.
OFFSITE_REST_USER=
OFFSITE_REST_PASSWORD=
# Host directory mounted as the offsite target (an NFS disk or similar).
# Only needed when OFFSITE_REPO is a path rather than a rest:/sftp: address; it
# appears under the same path inside the container so that OFFSITE_REPO reads
# identically on both sides.
OFFSITE_LOCAL_DIR=
# Passphrase of the repository key. WITHOUT IT THE BACKUPS ARE LOST - it has to
# be kept outside this machine (1Password vault Infrastructure-Backup, or on the
# project in the hosting backend), otherwise an offsite backup is worthless:
# exactly when it is needed, the machine is gone.
OFFSITE_PASSPHRASE=
# For sftp targets the SSH key is expected at $HOST_RUN_DIR/offsite/id_ed25519
# (mode 0600) and mounted read-only into the container; our backup server's
# certificate sits next to it as rest-server.crt and is placed there by
# `odoo offsite register`. Those paths are deliberately hard-wired rather than
# settings: settings values are not expanded recursively, so a path containing
# $HOST_RUN_DIR would arrive in the compose file literally.
# Schedule of the daily offsite run. Deliberately AFTER the pgbackrest base
# backup (PGBR_FULL_CRON / PGBR_DIFF_CRON, 02:00) so the run picks
# up the fresh state instead of yesterday's.
OFFSITE_BACKUP_CRON=0 4 * * *
# Retention. Against append-only targets (our backup server) the client cannot
# clean up - these values then describe what should apply SERVER-SIDE. Against
# sftp or path targets the run applies them itself after each backup.
OFFSITE_KEEP_DAILY=7
OFFSITE_KEEP_WEEKLY=4
OFFSITE_KEEP_MONTHLY=6
# Compression inside the repository: auto (the default, a good compromise), off
# when the sources are already compressed, max when the line costs more than the
# CPU.
OFFSITE_COMPRESSION=auto
# Additionally back up the dump files from $DUMPS_PATH. Off by default: with
# pgbackrest the database is already covered by WAL plus base backup, and
# /host/dumps often holds many old states.
#
# Without pgbackrest this is not needed at all: `odoo offsite backup` then pulls a
# fresh dump itself and takes exactly that one along - see
# OFFSITE_ALLOW_WITHOUT_DB.
OFFSITE_INCLUDE_DUMPS=0
# Emergency exit for the completeness check.
#
# The offsite run aborts when no database state would end up in the archive -
# neither via pgbackrest nor via a dump. That is deliberate: the filestore is always
# there, the database is not, and a snapshot of nothing but attachments looks
# like a backup until somebody wants to restore. 1 switches the check off and
# knowingly backs up the files only - which only makes sense when the database
# is provably backed up elsewhere.
OFFSITE_ALLOW_WITHOUT_DB=0
# And the same check in the other direction: the run aborts when the filestore
# is missing or empty. That is exactly what a volume looks like that was not
# mounted - the database would be saved and the attachments not, and it would
# only show up on restore. Set 1 only when the instance really has no
# attachments yet.
OFFSITE_ALLOW_WITHOUT_FILES=0
# Splitting the area into two repositories: <area>/db and <area>/files. That
# gives each of the two parts its own age, visible on the backup server - with
# everything in one repository an arriving filestore hides a database dump that
# stopped coming. "flat" is the old behaviour (everything in one repository) and
# is meant for legacy installations only.
OFFSITE_LAYOUT=split
# Write-only filestore backup. When both of these are set, the filestore is no
# longer backed up through restic but pushed to a write-only target: this
# machine can then neither read nor delete what it uploaded.
#
# It works because Odoo names attachments after the SHA-1 of their content -
# a file is written once, never changes, and "what is new?" is a pure name
# comparison against a local ledger. No repository index, no key.
#
# OFFSITE_WO_URL: the write-only receiver, e.g. https://10.222.0.106:8444/<area>/
# OFFSITE_WO_RECIPIENT: age PUBLIC key (age1…). Generate with `age-keygen`, keep
# the private key in 1Password - without it the filestore cannot be restored,
# and with it on this machine the whole point would be lost.
#
# Both empty = off, and the filestore travels through restic as before.
OFFSITE_WO_URL=
OFFSITE_WO_RECIPIENT=
# Derselbe Weg fuer die Datenbank: age-OEFFENTLICHER Schluessel, gegen den
# Basisbackups und WAL-Segmente verschluesselt werden. Ist er gesetzt, geht der
# Datenbankstrom nicht mehr durch restic.
#
# Bewusst ein ANDERER Schluessel als fuer den Filestore: die beiden haben
# verschiedenen Wert und werden getrennt gebraucht ("jemand darf den Filestore
# zurueckspielen, aber nicht die Datenbank"). Privater Teil in 1Password.
OFFSITE_WO_DB_RECIPIENT=
# Wie oft die WAL-Segmente hochgeschoben werden. Minuetlich, damit der Verlust
# bei einem Maschinenausfall eine Minute kostet und nicht eine Nacht. Der Lauf
# ist billig (nichts Neues = kein Upload) und laeuft nie doppelt (Lock).
# Halbfertige Segmente gibt es hier nicht: pgbackrest legt ein Segment erst im
# Archiv ab, wenn Postgres es fertig geschrieben hat.
OFFSITE_WAL_CRON=* * * * *
# Upload brake in KiB/s (0 = unlimited). Useful when the backup should not eat
# the production system's bandwidth.
OFFSITE_UPLOAD_LIMIT=0
# Offsite backup is a production concern and mere ballast on developer boxes -
# it is switched off on DEVMODE machines (see __after_settings.py). 1 forces it
# on anyway, e.g. for testing.
OFFSITE_FORCE_IN_DEVMODE=0
# Enrollment service on the backup server that `odoo offsite register` talks to.
OFFSITE_ENROLL_URL=https://10.222.0.106:8443
