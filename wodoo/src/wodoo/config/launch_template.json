{
  "tasks": [
    {
      "label": "launch:docker:odoo:debugpy",
      "type": "shell",
      "command": "CURRENT_FILE=${file} ODOO_PYTHON_DEBUG_PORT={ODOO_PYTHON_DEBUG_PORT} /bin/bash ~/.odoo/images/wodoo/src/wodoo/bin/launch_docker_debugpy.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "never",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "launch:pyenv",
      "type": "shell",
      "command": "/bin/bash ~/.odoo/images/wodoo/src/wodoo/bin/launch_pyenv.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "never",
        "panel": "shared"
      },
      "problemMatcher": []
    },
        {
            "label": "show:docker:result:logs",
            "type": "shell",
            "command": "CURRENT_FILE=${file} /bin/bash ~/.odoo/images/wodoo/src/wodoo/bin/launch_docker_debugpy_finish.sh",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": []
        }
  ],
  "configurations": [

    {
      "name": "docker",
      "type": "python",
      "request": "attach",
      "connect": {
        "host": "127.0.0.1",
        "port": {ODOO_PYTHON_DEBUG_PORT}
      },
      "preLaunchTask": "launch:docker:odoo:debugpy",
      "postDebugTask": "show:docker:result:logs",
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}",
          "remoteRoot": "/opt/src"
        }
      ],
      "justMyCode": false
    }
  ]
}
