{
  "tasks": [
    {
      "label": "launch:browser:debug",
      "type": "shell",
      "command": "/bin/bash ~/.odoo/images/wodoo/src/wodoo/bin/launch_browser_debug.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "never",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "launch:unittest:debug",
      "type": "shell",
      "command": "/bin/bash ~/.odoo/images/wodoo/src/wodoo/bin/launch_unittest_debug.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "never",
        "panel": "shared"
      },
      "problemMatcher": []
    }
  ],
  "configurations": [
    {
      "name": "browser with localpyenv",
      "type": "python",
      "request": "launch",

      "python": "~/.odoo/run/__PROJECT_NAME__/.venv/bin/python3",
      "program": "${workspaceFolder}/odoo/odoo-bin",
      "preLaunchTask": "launch:browser:debug",
      "args": [
        "--log-level=debug",
        "--dev=all",
        "--http-interface=0.0.0.0",
        "--http-port={DEBUG_PORT}",
        "--workers=0",
        "--max-cron-threads=0"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONUNBUFFERED": "1",
        "GEVENT_SUPPORT": "true"
      },
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "browser with docker",
      "type": "python",
      "request": "attach",
      "connect": {
        "host": "127.0.0.1",
        "port": {ODOO_PYTHON_DEBUG_PORT}
      },
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}",
          "remoteRoot": "/opt/src"
        }
      ],
      "justMyCode": false
    },
    {
      "name": "unittest",
      "type": "python",
      "request": "launch",

      "python": "~/.odoo/run/__PROJECT_NAME__/.venv/bin/python3",
      "program": "${workspaceFolder}/odoo/odoo-bin",
      "preLaunchTask": "launch:unittest:debug",
      "args": [
        "--log-level=debug",
        "--no-http",
        "--workers=0",
        "--max-cron-threads=0",
        "--test-file=${file}",
        "--stop-after-init"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONUNBUFFERED": "1",
        "GEVENT_SUPPORT": "true"
      },
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}
