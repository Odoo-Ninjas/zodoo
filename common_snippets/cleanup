RUN rm -rf /var/lib/apt/lists/* \
/tmp/* \
/var/tmp/* \
/var/log/* \
/usr/share/doc \
/usr/share/man

# Statische Libraries löschen
RUN find /usr -name '*.a' -delete

RUN if [[ -e /usr/bin/apt-get ]]; then \
apt-get purge build-essential gcc libpq-dev && \
apt-get autoremove -y && \
apt-get purge -y imagemagick-dev libmagickcore-dev libmagickwand-dev || true && \
apt-get clean; \
fi
