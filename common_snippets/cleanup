# Statische Libraries löschen
RUN find /usr -name '*.a' -delete

RUN if [ -e /usr/bin/apt-get ]; then \
apt-get purge -y build-essential gcc g++ libpq-dev && \
apt-get autoremove -y && \
apt-get clean -y && \
rm -rf /var/lib/apt/lists/*; \
fi

RUN rm -rf /var/lib/apt/lists/* \
/tmp/* \
/var/tmp/* \
/var/log/* \
/usr/share/doc \
/usr/share/man

RUN rm -Rf \
/tmp/* \
/var/tmp/* \
/var/log/* \
/usr/share/doc \
/usr/share/man \
/usr/share/icons \
/usr/share/vim \
/usr/share/man \
/usr/share/perl \
/usr/share/poppler \
/usr/lib/gcc \
/var/cache \
/usr/lib/git-core \
/var/lib/dpkg \
/usr/include 

RUN find / -type d -name __pycache__  -exec rm -Rf {} + 2> /dev/null || true
RUN rm /usr/bin/aarch64-linux-gnu-lto-dump-11 || true