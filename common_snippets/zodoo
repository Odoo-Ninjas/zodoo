# Check if build-time user is root
RUN if [ "$(id -u)" -ne 0 ]; then \
      echo "ERROR: This Dockerfile must be built as root!" >&2; \
      exit 1; \
    fi
ENV ZODOO_SRC=/opt/zodoo
ENV ZODOO_PIPX_HOME=/opt/zodoo_pipx
ENV ZODOO_ENV_DIR=/opt/zodoo_pipx/venvs/zodoo
ENV ZODOO_PYTHON=$ZODOO_ENV_DIR/bin/python3
COPY zodoo_src/ /opt/zodoo

#___SNIPPET_PYTHON311___

RUN /usr/bin/python3.11 -m venv "$ZODOO_ENV_DIR" && \
     $ZODOO_PYTHON -m pip install $(cat /etc/pip_options) --upgrade pip && \
     $ZODOO_PYTHON -m pip install $(cat /etc/pip_options) pipx setuptools wheel --upgrade && \
     $ZODOO_PYTHON -mpip install $(cat /etc/pip_options) lxml==4.9.3

RUN \
if [ "$ODOO_VERSION"  != '11' ]; then \
     PIPX_HOME="${ZODOO_PIPX_HOME}" \
     PIPX_BIN_DIR=/usr/local/bin \
     PIP_VERBOSE=1 \
     PIPX_DEFAULT_PYTHON=$ZODOO_PYTHON \
     $ZODOO_PYTHON \
     -mpipx \
     install  \
     --force \
     --verbose \
     -e \
     "$ZODOO_SRC" \
     || (echo "=== pipx install failed ===" && \
          cat $ZODOO_PIPX_HOME/logs/*.log && \
          exit 1) \
fi

RUN \
export HOME=/root && \
mkdir -p $HOME/.local/bin && \
echo 'export PATH=$PATH:$HOME/.local/bin' >> $HOME/.bashrc && \
echo "export ZODOO_PYTHON=$ZODOO_PYTHON" >> /etc/bash.bashrc && \
echo "export ZODOO_PYTHON=$ZODOO_PYTHON" >> /etc/profile.d/zodoo_python.sh && \
echo "alias odoo=\"$(dirname $ZODOO_PYTHON)/odoo\"" >> /etc/profile.d/zodoo_python.sh && \
echo "alias odoo=\"$(dirname $ZODOO_PYTHON)/odoo\"" >> $HOME/.bashrc && \
ln -sf "$ZODOO_ENV_DIR/bin/odoo" /usr/bin/odoo && \
chmod +x /etc/profile.d/zodoo_python.sh
