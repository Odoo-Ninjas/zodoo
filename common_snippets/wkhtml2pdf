WORKDIR /tmp

# TARGETARCH is only populated by BuildKit when the build is invoked with
# --platform (e.g. buildx). In single-platform builds it's empty, which would
# skip both branches below and silently leave the image without wkhtmltopdf.
# Fall back to dpkg's architecture so the install happens unconditionally.
RUN ARCH="${TARGETARCH:-$(dpkg --print-architecture)}" && \
    case "$ARCH" in \
        amd64|arm64) ;; \
        *) echo "wkhtmltopdf: unsupported arch '$ARCH'"; exit 1 ;; \
    esac && \
    curl -fsSL -o /root/wkhtmltox.deb \
        "https://github.com/wkhtmltopdf/packaging/releases/download/0.12.6.1-3/wkhtmltox_0.12.6.1-3.jammy_${ARCH}.deb" && \
    #___SNIPPET_APT_INSTALL___ \
    /root/wkhtmltox.deb && \
    rm -rf /var/lib/apt/lists/* /root/wkhtmltox.deb && \
    wkhtmltopdf --version
