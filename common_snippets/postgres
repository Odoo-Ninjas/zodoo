RUN \
    $(mv /etc/apt/apt.conf.d/01proxy /tmp || true) && \
    mkdir -p /etc/apt/keyrings && \
    curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc | gpg --dearmor -o /etc/apt/keyrings/pgdg.gpg && \
    echo "deb [signed-by=/etc/apt/keyrings/pgdg.gpg] http://apt.postgresql.org/pub/repos/apt $(lsb_release -cs)-pgdg main" \
        > /etc/apt/sources.list.d/pgdg.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
    libpq-dev \
    postgresql-client-17 && \
    $(mv /tmp/01proxy /etc/apt/apt.conf.d || true)
RUN \
set -x && \
if [ "$POSTGRES_VERSION" = "17" ]; then \
  apt-get purge -y postgresql-14 postgresql-client-14 postgresql-contrib-14 || true; \
  apt-get purge -y postgresql-15 postgresql-client-15 postgresql-contrib-15 || true; \
  apt-get purge -y postgresql-16 postgresql-client-16 postgresql-contrib-16 || true; \
  #___SNIPPET_APT_INSTALL___ \
  postgresql-client-17; \
elif [ "$POSTGRES_VERSION" = "16" ]; then \
  apt-get purge -y postgresql-17 postgresql-client-17 postgresql-contrib-17 || true; \
  apt-get purge -y postgresql-15 postgresql-client-15 postgresql-contrib-15 || true; \
  apt-get purge -y postgresql-16 postgresql-client-16 postgresql-contrib-16 || true; \
  #___SNIPPET_APT_INSTALL___ \
  postgresql-client-16; \
elif [ "$POSTGRES_VERSION" = "15" ]; then \
  apt-get purge -y postgresql-14 postgresql-client-14 postgresql-contrib-14 || true; \
  apt-get purge -y postgresql-17 postgresql-client-17 postgresql-contrib-17 || true; \
  apt-get purge -y postgresql-16 postgresql-client-16 postgresql-contrib-16 || true; \
  #___SNIPPET_APT_INSTALL___ \
  postgresql-client-15; \
else \
  apt-get purge -y postgresql-15 postgresql-client-15 postgresql-contrib-15 || true; \
  apt-get purge -y postgresql-17 postgresql-client-17 postgresql-contrib-17 || true; \
  apt-get purge -y postgresql-16 postgresql-client-16 postgresql-contrib-16 || true; \
  #___SNIPPET_APT_INSTALL___ \
  postgresql-client-14; \
fi
