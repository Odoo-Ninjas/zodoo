RUN_PGBACKREST=0
# pgBackRest: base backups + WAL archive with point-in-time recovery.
#
# Replaces the barman path. The two differ in one fundamental way that shapes
# everything below:
#
#   barman STREAMED the WAL (pg_receivewal against a replication slot). Nothing
#   had to run inside the postgres container.
#   pgBackRest ARCHIVES the WAL (archive_command). That command is executed by
#   the postgres server process itself, so the pgbackrest binary has to exist in
#   the postgres image and be configured there.
#
# What that buys in return:
#
#   * incremental backups at PAGE level (8 KiB), not whole-file. A base backup
#     that changed ten rows costs ten pages.
#   * expiry is part of the backup run, not a separate job that can be forgotten
#     (which is exactly how 3.4 TB of dumps accumulated).
#   * the repository can live on a REPO HOST, so this machine holds no
#     passphrase and has no delete rights - see PGBR_REPO_HOST.
#
# ---------------------------------------------------------------------------
# WHY THE PREFIX IS PGBR_ AND NOT PGBACKREST_
#
# pgBackRest reads its OWN options from the environment, prefixed PGBACKREST_:
# PGBACKREST_REPO_HOST is the option repo-host, PGBACKREST_BUNDLE is bundle,
# and so on. zodoo exports every setting into every container, so a setting
# called PGBACKREST_ANYTHING is handed straight to pgbackrest as one of its
# own options.
#
# That is not theoretical - it broke every command in the container:
#
#   ERROR: [031]: option 'repo-host-type' requires an index
#   WARN: environment contains invalid option 'bundle'
#
# and the ones that ARE valid options are worse, because they silently
# override the configuration file instead of failing. Never name a setting
# here PGBACKREST_*.
# ---------------------------------------------------------------------------
#
# The stanza name. One stanza = one postgres cluster. It ends up in the
# repository path, so on a shared repo host it must be unique per instance -
# hence the project name rather than a fixed "odoo".
PGBR_STANZA=$PROJECT_NAME
#
# ------------------------------------------------------------------ version --
#
# THE most important operational setting here, and the least obvious.
#
# pgBackRest requires the SAME version on every host that talks to a
# repository. Client and repo server alike. On a mismatch archiving and
# backups simply stop:
#
#   [ProtocolError] expected value '2.59' for greeting key 'version'
#                   but got '2.50'
#
# Unpinned, each image build picks up whatever pgdg publishes that day, so two
# images built weeks apart already disagree - and it only surfaces against the
# backup server, at 2 a.m., on the machine nobody rebuilt.
#
# The host distribution is irrelevant, which is the good news: pgbackrest never
# runs on the host. It runs in our images - the sidecar (ubuntu:24.04) and the
# postgres images (debian) - so an Ubuntu 20.04, Arch or RHEL host makes no
# difference. Only THIS number decides.
#
# Upgrading: change it here, rebuild, and upgrade the backup server in the same
# window. The repository format is stable across 2.x, so it is only the
# binaries.
PGBR_VERSION=2.59.1
#
# ---------------------------------------------------------------- repository --
#
# Empty = LOCAL repository in the pgbackrest_data volume. That is the
# development/test setup: everything on one machine, no certificates, no second
# host. Good enough to take a backup and restore it, and the only mode that
# works without a backup server.
#
# Set = REPO HOST. The repository then lives on that machine and this one talks
# to it over TLS. This is the production setup, and it is the whole reason to
# prefer pgBackRest over a client-side-encrypting archive: the cipher passphrase
# and the delete rights stay on the repo host. A compromised Odoo machine can
# push WAL and nothing else - it cannot read the history and cannot destroy it.
PGBR_REPO_HOST=
#
# TWO ports, because the repo-host topology needs TWO connections in OPPOSITE
# directions - which is the thing to know before opening anything in a firewall:
#
#   this machine  --> backup server   WAL (archive-push), continuously.
#                                     Port PGBR_REPO_HOST_PORT, outbound.
#   backup server --> this machine    the base backup, but ONLY with
#                                     PGBR_BACKUP_FROM=repo-host. Port
#                                     PGBR_TLS_SERVER_PORT, INBOUND.
#                                     With the default (=here) this direction
#                                     does not exist and everything is outbound.
#
# See PGBR_BACKUP_FROM below for which of the two you get and what each
# one costs.
#
# Both are freely settable (1-65535), so 443 on either side is fine and is the
# usual answer to a restrictive firewall. But note what this is NOT: pgbackrest
# speaks its own protocol inside TLS, not HTTP inside TLS. Port 443 gets it
# through a port-based firewall; it does NOT survive an HTTPS reverse proxy
# that terminates TLS. Only TCP/SNI passthrough works. Details in the docs.
PGBR_REPO_HOST_PORT=8432
#
# WHICH machine runs `pgbackrest backup` - and with it `expire`. Only relevant
# when PGBR_REPO_HOST is set.
#
#   here       This machine pushes. EVERY connection is outbound, nothing has
#              to be reachable from the backup server, and no port is opened.
#              The cost: this machine can delete from the repository, because
#              expiring a backup is a delete. Fine when the backup server
#              copies the repository onward to a write-only target - the
#              protection then lives one layer further out.
#
#   repo-host  The backup server pulls. This machine holds no delete rights at
#              all, which is stronger, but the backup server has to be able to
#              REACH this machine on PGBR_TLS_SERVER_PORT.
#
# Retention is NOT affected by this setting. With any repo host it lives on the
# backup server in both modes - see the retention block below.
PGBR_BACKUP_FROM=here
# The port this machine LISTENS on for the repo host. Only used - and only
# published on the host - with PGBR_BACKUP_FROM=repo-host. Pushing from
# here has nothing to serve and should not open a port.
PGBR_TLS_SERVER_PORT=8432
# TLS rather than SSH. Both are supported by pgbackrest; TLS is the recommended
# transport for new setups (no shell account on either side, and markedly less
# per-operation overhead when many small archive-push calls run all day).
PGBR_REPO_HOST_TYPE=tls
# Certificates for the TLS transport. Expected in
# $HOST_RUN_DIR/pgbackrest/cert/ and mounted read-only into both containers.
# Paths are hard-wired rather than settings because settings values are not
# expanded recursively - a "$HOST_RUN_DIR/..." here would arrive literally.
#
# NOTE: there is no enrolment command yet. The certificates have to be placed
# by hand, so the repo-host mode is not turnkey - the local repository below
# is, and is what the local tests use.
#   ca.crt      certificate authority of the backup server
#   client.crt  this machine's certificate
#   client.key  its private key (mode 0600)
# Note this is an IDENTITY, not a decryption key: it proves who may write. It
# does not open the repository.
#
# ---------------------------------------------------------------- encryption --
#
# Repository encryption. Empty = OFF, and then the backups lie on the backup
# server as plain zstd: the manifest is readable text and every data file
# unpacks with `zstd -d`. That matters because the storage underneath is not
# ours (NFS from an external provider).
#
# WHERE THE PASSPHRASE LIVES: here, on this machine. pgBackRest encrypts
# CLIENT-SIDE - the backup server only ever stores ciphertext and never learns
# the passphrase. That is the property worth having: a compromised backup
# server, or a curious storage provider, gets nothing.
#
# One passphrase PER AREA (stanza), issued by `pgbackrest-area create` on the
# backup server, shown exactly once, then forgotten by the server.
#
# TWO THINGS THAT BITE:
#
#   * Lose the passphrase and the backup is WORTHLESS. It belongs in 1Password
#     before the first backup runs - same rule as the old restic repo keys.
#   * It CANNOT be switched on later. pgBackRest cannot convert an existing
#     repository; the stanza has to be created fresh and the history starts
#     over. So decide before real data goes in.
PGBR_CIPHER_TYPE=aes-256-cbc
PGBR_CIPHER_PASS=
#
# ------------------------------------------------------------------ retention --
#
# THESE APPLY TO A LOCAL REPOSITORY ONLY.
#
# With PGBR_REPO_HOST set they are ignored, and the rendered
# configuration leaves them out rather than pretending otherwise. Retention
# belongs to whoever manages the disk, and that is the backup server: it runs
# `pgbackrest --stanza=<stanza> expire` from its own cron with its own values.
# One place, on the machine that actually watches the free space - rather than
# the same number maintained on every Odoo host and drifting.
#
# Practical consequence: without repo1-retention-* the expire step at the end
# of a backup is a no-op. That is intended here. It is NOT intended for a local
# repository, where nothing else would ever clean up - so there the values
# below are always written, falling back to the default when left empty.
#
# How many full backups to keep, or - with type=time - over how many days a
# continuous point-in-time window is maintained.
#
# time is the better default: it describes what somebody actually promises a
# customer ("we can go back 14 days to any second"), while a count silently
# means something different as soon as the backup schedule changes.
PGBR_RETENTION_FULL_TYPE=time
PGBR_RETENTION_FULL=14
# Differential backups to keep. Empty = governed by the full retention alone.
PGBR_RETENTION_DIFF=
# WAL retention. Empty (the default) keeps the WAL needed for a CONTINUOUS
# window across every retained full backup - point-in-time recovery to any
# second in the window above.
#
# Setting it to a number keeps continuous WAL only for that many recent
# backups; older ones stay restorable, but only to their own end point. That is
# the lever when the WAL volume rather than the backups dominates the space:
# you keep the old states and stop paying for the gaps between them.
PGBR_RETENTION_ARCHIVE=
PGBR_RETENTION_ARCHIVE_TYPE=full
#
# -------------------------------------------------------------------- schedule --
#
# Weekly full, daily differential, and optionally intra-day incrementals.
#
# NOT a daily full: at roughly 16 GiB per full for a 45 GiB database that would
# be 5.8 TiB per year for a single instance. A weekly full plus daily diffs
# costs a fraction of it and restores just as fast.
#
# Sunday for the full because that is the quietest day - the least data changes
# under the backup, so it is the cheapest and least intrusive slot.
#
# Diff rather than incr for the daily rhythm on purpose: a differential depends
# only on the full, an incremental on its predecessor. A chain of six
# incrementals has to be read end to end on restore and one damaged link takes
# all its successors with it. With block-level incrementals a diff costs barely
# more than an incr.
PGBR_FULL_CRON=0 2 * * 0
PGBR_DIFF_CRON=0 2 * * 1-6
# Intra-day incrementals. Empty = off. Worth switching on for write-heavy
# instances: it does not improve the recovery POINT (the WAL archive already
# gives you every second), it shortens the recovery TIME, because less WAL has
# to be replayed - and that replay is single-threaded.
PGBR_INCR_CRON=
#
# ----------------------------------------------------------------- compression --
#
# zst is the best compromise (roughly a third of the raw size at low CPU cost).
# Alternatives: lz4 (faster, weaker), gz (compatible, slower), none (when the
# line is free and the CPU is not).
PGBR_COMPRESS_TYPE=zst
PGBR_COMPRESS_LEVEL=3
# Parallel worker processes for backup, restore and archive-push. The single
# biggest factor in how long a backup takes; 4 is a reasonable default that does
# not eat a production box alive.
PGBR_PROCESS_MAX=4
# Block-level incrementals: within a changed file, store only the changed
# blocks. This is what makes a differential cheap and it is the main reason
# pgBackRest beats a chunk-based deduplicating archive on a database - postgres
# knows exactly which 8 KiB pages changed, so nothing has to be rediscovered by
# hashing a byte stream.
PGBR_BLOCK=y
# Bundle small files into larger objects. A postgres data directory contains
# thousands of tiny files; without bundling each becomes its own repository
# object, which is slow on any remote target and outright painful on NFS.
PGBR_BUNDLE=y
#
# ------------------------------------------------------------------ archiving --
#
# Asynchronous WAL archiving: the archive_command hands the segment to a spool
# directory and returns immediately, while background processes push in
# parallel. Without it a burst of WAL serialises through one process and
# pg_wal starts growing - the classic way a busy instance fills its disk.
PGBR_ARCHIVE_ASYNC=y
PGBR_ARCHIVE_PUSH_QUEUE_MAX=1GB
#
# ---------------------------------------------------------------------- misc --
#
# Continuous archiving and nightly base backups are a production concern and
# pure overhead on a developer box, so this is off under DEVMODE (see
# __after_settings.py). 1 forces it on anyway - which is what you want to test
# the integration locally.
PGBR_FORCE_IN_DEVMODE=0
# Safeguard `odoo update`: when 1 (and RUN_PGBACKREST=1) every update first sets
# a named restore point. If the update fails, the console offers to rewind the
# database to that pre-update state.
PGBR_GUARD_UPDATE=0

# --------------------------------------------------------------------------- #
# ENROLMENT
# --------------------------------------------------------------------------- #
# Address of the enrolment service on the backup server. `odoo pgbackrest
# register` files a request there, an admin approves it, and the same command
# then collects stanza, client certificate and passphrase and writes them into
# the settings.
#
# Deliberately a separate port from PGBR_REPO_HOST_PORT: 8443 is pgBackRest's
# own protocol, which is not HTTP. 8444 belongs to the write-only receiver that
# takes the filestores. The enrolment service is ordinary HTTPS and sits beside
# both on 8445.
PGBR_ENROLL_URL=https://db.backup.zebroo.de:8445
